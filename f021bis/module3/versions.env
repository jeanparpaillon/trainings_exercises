# Versions of module 3, in one place. Sourced by the step files
# (`source versions.env`, from module3/) and included by the Makefiles: plain
# KEY=value, no quotes, no spaces, so both bash and make read it.

# Module 1's KIND_NODE_TO, already pulled in every console.
KIND_NODE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# Must match the room's server (../shared-cluster/zabbix/kustomization.yaml):
# same major for the proxy to be accepted, same tag for the agents, to keep
# one version in the room.
ZABBIX_VERSION=7.0.31

# The official chart, from Zabbix's 7.0 repository. Two names are published
# there: zabbix-helm-chrt (up to 1.2.4) and zabbix-helm-chart (1.3.x, the
# current one). Its appVersion is 7.0.17: the image tags are overridden with
# ZABBIX_VERSION in the values. With release name `zabbix`, its objects are
# zabbix-zabbix-helm-chart-*, the names lab 2's templates expect by default.
ZABBIX_CHART=zabbix-helm-chart
ZABBIX_CHART_VERSION=1.3.4
ZABBIX_CHART_REPO=https://cdn.zabbix.com/zabbix/integrations/kubernetes-helm/7.0

# kube-state-metrics: the chart's dependency (kube-state-metrics chart 5.7.0),
# not chosen here. The cluster state template (lab 2) relies on its metric
# names.
KSM_VERSION=v2.9.2

# Module 2's; podinfo exposes Prometheus metrics on :9898/metrics (lab 3).
# The image tag is the chart version.
PODINFO_CHART=podinfo
PODINFO_CHART_VERSION=6.15.0
PODINFO_CHART_REPO=https://stefanprodan.github.io/podinfo
