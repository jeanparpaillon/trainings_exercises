apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: web
  labels:
    app: web
spec:
  replicas: {{ app_replicas }}
  selector:
    matchLabels:
      app: web
  template:
    metadata:
      labels:
        app: web
      annotations:
        # A new page changes the pod template, hence a rollout: a mounted
        # ConfigMap alone is only picked up by the kubelet a minute later.
        checksum/page: "{{ lookup('ansible.builtin.template', 'index.html.j2') | hash('sha256') }}"
    spec:
      containers:
        - name: nginx
          image: nginx:1.30.6-alpine
          ports:
            - name: http
              containerPort: 80
          env:
            - name: WEB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: web-credentials
                  key: password
          readinessProbe:
            httpGet: { path: /, port: http }
          resources:
            requests: { cpu: 10m, memory: 16Mi }
            limits: { memory: 64Mi }
          volumeMounts:
            - name: content
              mountPath: /usr/share/nginx/html
      volumes:
        - name: content
          configMap:
            name: web-content
