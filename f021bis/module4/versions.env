# Versions of module 4, in one place. Included by the Makefile: plain
# KEY=value, no quotes, no spaces.
#
# Ansible 2.9: the last release before collections, as close to EX407 (2.7)
# as Rocky 9 allows. 2.7 itself was tried and cannot manage Rocky 9: its
# modules call platform.dist(), gone since Python 3.8, and Rocky 9 has
# nothing older than 3.9. 2.9 does not run on the console's Python 3.12
# either (removed stdlib modules): `make venv` gets uv, which gets a Python
# 3.8 build, and the venv is made from that. The other pins are 2.9's
# dependencies as they were in its time — Jinja2 3.1 dropped what its
# filters import, MarkupSafe 2.1 what Jinja2 2.11 imports; setuptools and
# cryptography only to silence deprecation warnings on every command.

UV_VERSION=0.12.3
PYTHON_VERSION=3.8
ANSIBLE_VERSION=2.9.27
JINJA2_VERSION=2.11.3
MARKUPSAFE_VERSION=1.1.1
SETUPTOOLS_VERSION=66.1.1
CRYPTOGRAPHY_VERSION=42.0.8
