# WordPress again, through Gateway API instead of the Ingress of module 1,
# on a second host name. Render it into httproute.yaml (git-ignored):
#
#   sed "s/CHANGEME/$NS/g" network/step2-gateway/httproute.yaml.tmpl \
#     > network/step2-gateway/httproute.yaml
#
# The Gateway is shared and belongs to the platform (namespace traefik);
# the route belongs to you and attaches to it with parentRefs.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: wordpress
spec:
  parentRefs:
    - { name: traefik-gateway, namespace: traefik }
  hostnames:
    - wordpress-gw.CHANGEME.195.35.2.222.nip.io
  # No `matches`: the default is every path (PathPrefix /).
  rules:
    - backendRefs:
        - { name: wordpress, port: 80 }
