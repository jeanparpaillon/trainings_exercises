#!/usr/bin/env bash
# Prints a kubeconfig for ServiceAccount ci-deployer in $NS: the public API
# address, the cluster CA, and a token valid 8 hours (the length of the
# session, not of the training).
#
#   module6/step2-push/ci-kubeconfig > /tmp/kc
#   gh secret set KUBECONFIG_DEV < /tmp/kc && rm /tmp/kc
set -euo pipefail
: "${NS:?set NS to your namespace}"

server=https://srv2052563.hstgr.cloud:6443
ca=$(kubectl -n "$NS" get configmap kube-root-ca.crt -o jsonpath='{.data.ca\.crt}' | base64 -w0)
token=$(kubectl -n "$NS" create token ci-deployer --duration=8h)

cat <<KUBECONFIG
apiVersion: v1
kind: Config
clusters:
  - name: training
    cluster:
      server: $server
      certificate-authority-data: $ca
users:
  - name: ci-deployer
    user:
      token: $token
contexts:
  - name: ci
    context:
      cluster: training
      user: ci-deployer
      namespace: $NS
current-context: ci
KUBECONFIG
