#!/usr/bin/env bash
# Copies a step's files into your config repo, with your namespace (CHANGEME)
# and the repo's owner (GHOWNER) filled in, then shows what changed.
#
#   module6/copy step1-envs              # into $REPO, for namespace $NS
#   module6/copy repo <dir> <ns> <owner> # the trainer, creating a repo
#
# Copies <step>/files/ when it exists, else the whole directory. Files are
# overwritten: commit (or stash) your own changes first.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
src=${1:?usage: module6/copy <step> [dest ns owner]}
dest=${2:-${REPO:?set REPO to your config repo clone}}
ns=${3:-${NS:?set NS to your namespace}}
owner=${4:-$(git -C "$dest" remote get-url origin | sed -E 's#^.*github\.com[:/]([^/]+)/.*$#\1#')}

src=$here/${src%/}
[ -d "$src/files" ] && src=$src/files
[ -d "$src" ] || { echo "no such step: $1" >&2; exit 1; }

(cd "$src" && find . -type f -print0) | while IFS= read -r -d '' f; do
  mkdir -p "$dest/$(dirname "$f")"
  sed -e "s/GHOWNER/$owner/g" -e "s/CHANGEME/$ns/g" "$src/$f" > "$dest/$f"
done

git -C "$dest" status --short 2>/dev/null || true
