#!/usr/bin/env bash
# Renders the per-trainee manifests from templates/ and TRAINEES in fleet.env:
#
#   tenants/<name>.yaml           namespace, admin, quota, Headlamp read
#   tenants/<name>-flux.yaml      module 6 Flux tenant, on $GITHUB_OWNER/f021-<name>
#   room/consoles/<name>.yaml     web console
#
# Trainee names are generic (user1, user2…), never a person's: the output is
# committed, Flux applies it from git.
#
# and the two kustomization.yaml that list them. Everything under tenants/ and
# room/consoles/ except namespace.yaml is generated: edit the templates, then
# run this again and commit the result.
#
# A Flux tenant already uncommented in tenants/kustomization.yaml stays
# uncommented.
#
#   bin/render
set -euo pipefail
cd "$(dirname "$0")/.."
. ./fleet.env

trainees() { printf '%s\n' $TRAINEES; }

# Flux tenants enabled so far: uncommented entries of the current list.
enabled=$(sed -n 's/^  - \([a-z0-9-]*\)-flux\.yaml$/\1/p' tenants/kustomization.yaml 2>/dev/null || true)

mkdir -p tenants room/consoles
find tenants room/consoles -name '*.yaml' ! -name namespace.yaml -delete

render() {  # template name > output
  local admin='/^#@admin /d'
  [ "$TRAINEES_CLUSTER_ADMIN" = true ] && admin='s/^#@admin //'
  sed -e "$admin" -e "s/NAME/$2/g" -e "s/GITHUB/$GITHUB_OWNER/g" -e "s/HOST/$HOST/g" "templates/$1"
}

{
  echo '# Generated by bin/render from TRAINEES in fleet.env. To enable a'
  echo "# trainee's module 6 Flux tenant, uncomment their -flux.yaml line (and"
  echo '# commit): bin/render keeps it uncommented.'
  echo 'apiVersion: kustomize.config.k8s.io/v1beta1'
  echo 'kind: Kustomization'
  echo 'resources:'
} > tenants/kustomization.yaml
{
  echo '# Generated by bin/render from TRAINEES in fleet.env.'
  echo 'apiVersion: kustomize.config.k8s.io/v1beta1'
  echo 'kind: Kustomization'
  echo 'resources:'
  echo '  - namespace.yaml'
} > room/consoles/kustomization.yaml

n=0
while read -r name; do
  [[ $name =~ ^[a-z][a-z0-9-]*$ ]] || { echo "bad name: $name" >&2; exit 1; }
  render tenant.yaml.tmpl "$name" > "tenants/$name.yaml"
  echo "  - $name.yaml" >> tenants/kustomization.yaml
  render tenant-flux.yaml.tmpl "$name" > "tenants/$name-flux.yaml"
  if grep -qx "$name" <<< "$enabled"; then
    echo "  - $name-flux.yaml" >> tenants/kustomization.yaml
  else
    echo "  # - $name-flux.yaml" >> tenants/kustomization.yaml
  fi
  render console.yaml.tmpl "$name" > "room/consoles/$name.yaml"
  echo "  - $name.yaml" >> room/consoles/kustomization.yaml
  n=$((n + 1))
done < <(trainees)

{
  echo 'images:'
  echo '  # console/, loaded into the kind node by make image (CONSOLE_IMAGE in fleet.env)'
  echo '  - name: console'
  echo "    newName: ${CONSOLE_IMAGE%:*}"
  echo "    newTag: \"${CONSOLE_IMAGE##*:}\""
} >> room/consoles/kustomization.yaml

echo "rendered $n trainees"
