#!/usr/bin/env bash
# Writes secrets.yaml: every Secret the fleet expects, plus the namespaces
# they live in. Applied by hand, before `flux bootstrap` and after each change:
#
#   bin/gen-secrets
#   kubectl apply --server-side -f secrets.yaml
#
# The values themselves are kept in secrets/ — git-ignored, like
# secrets.yaml. Keep a copy of secrets/ somewhere safe: rebuilding the
# cluster with the same secrets/ gives back the same passwords, the same
# Linkerd trust anchor and the same deploy keys (already registered on GitHub).
# Whatever is missing there is generated:
#
#   secrets/passwords.txt          <name> <password> <url>, one per trainee:
#                                  console and Grafana login (the format of
#                                  the server's /root/users/consoles.txt)
#   secrets/grafana-admin          Grafana `admin` password
#   secrets/linkerd-dashboard      Linkerd dashboard password (user trainee)
#   secrets/registry               registry password (user trainee)
#   secrets/linkerd/ca.{crt,key}   Linkerd trust anchor, 10 years
#   secrets/linkerd/issuer.{crt,key}  Linkerd identity issuer, 1 year
#   secrets/deploy-keys/<name>{,.pub}  module 6 deploy keys, one per trainee
#
#   bin/gen-secrets --renew-issuer    new issuer from the same trust anchor
#
# Needs openssl, ssh-keygen, ssh-keyscan, kubectl, and htpasswd
# (apache2-utils: bcrypt, which the registry requires).
set -euo pipefail
cd "$(dirname "$0")/.."
. ./fleet.env

renew_issuer=false
[ "${1:-}" = --renew-issuer ] && renew_issuer=true

command -v htpasswd >/dev/null || { echo "htpasswd missing: apt install apache2-utils" >&2; exit 1; }

S=secrets
mkdir -p "$S/linkerd" "$S/deploy-keys"
chmod 700 "$S"
umask 077

trainees() { printf '%s\n' $TRAINEES; }
pw() { openssl rand -base64 18 | tr -d '/+=' | cut -c1-16; }
keep() { [ -s "$1" ] || pw > "$1"; cat "$1"; }   # file -> password, created once

# --- passwords --------------------------------------------------------------
touch "$S/passwords.txt"
while read -r name _; do
  grep -q "^$name " "$S/passwords.txt" || echo "$name $(pw) https://$HOST/$name/" >> "$S/passwords.txt"
done < <(trainees)
grafana_pw=$(keep "$S/grafana-admin")
dashboard_pw=$(keep "$S/linkerd-dashboard")
registry_pw=$(keep "$S/registry")

# --- Linkerd identity -------------------------------------------------------
L=$S/linkerd
if [ ! -s "$L/ca.key" ]; then
  openssl ecparam -name prime256v1 -genkey -noout -out "$L/ca.key"
  openssl req -x509 -new -key "$L/ca.key" -sha256 -days 3650 \
    -subj /CN=root.linkerd.cluster.local \
    -addext basicConstraints=critical,CA:TRUE \
    -addext keyUsage=critical,keyCertSign,cRLSign \
    -out "$L/ca.crt"
  renew_issuer=true
fi
if $renew_issuer || [ ! -s "$L/issuer.key" ]; then
  openssl ecparam -name prime256v1 -genkey -noout -out "$L/issuer.key"
  openssl req -new -key "$L/issuer.key" -subj /CN=identity.linkerd.cluster.local -out "$L/issuer.csr"
  openssl x509 -req -in "$L/issuer.csr" -CA "$L/ca.crt" -CAkey "$L/ca.key" -CAcreateserial \
    -days 365 -sha256 \
    -extfile <(printf '%s\n' basicConstraints=critical,CA:TRUE,pathlen:0 keyUsage=critical,keyCertSign,cRLSign) \
    -out "$L/issuer.crt" 2>/dev/null
  rm -f "$L/issuer.csr"
fi

# --- module 6 deploy keys ---------------------------------------------------
known_hosts=$S/github_known_hosts
[ -s "$known_hosts" ] || ssh-keyscan -t ecdsa,ed25519,rsa github.com 2>/dev/null > "$known_hosts"
while read -r name; do
  k=$S/deploy-keys/$name
  [ -s "$k" ] || ssh-keygen -q -t ed25519 -N '' -C "flux-$name@f021" -f "$k"
done < <(trainees)

# --- secrets.yaml -----------------------------------------------------------
ns() { printf -- '---\napiVersion: v1\nkind: Namespace\nmetadata:\n  name: %s\n' "$1"; }
secret() { echo ---; kubectl create secret "$@" --dry-run=client -o yaml; }

{
  echo "# Generated by bin/gen-secrets from secrets/. Never commit."
  for n in flux-system linkerd linkerd-viz monitoring registry consoles; do ns "$n"; done

  secret generic linkerd-trust-anchor -n flux-system --from-file=ca.crt="$L/ca.crt"
  secret generic linkerd-identity-issuer -n linkerd --type=kubernetes.io/tls \
    --from-file=tls.crt="$L/issuer.crt" --from-file=tls.key="$L/issuer.key" --from-file=ca.crt="$L/ca.crt"
  secret generic grafana-admin -n monitoring \
    --from-literal=admin-user=admin --from-literal=admin-password="$grafana_pw"
  secret generic dashboard-auth -n linkerd-viz \
    --from-literal=users="$(htpasswd -nbB trainee "$dashboard_pw")"
  secret generic registry-htpasswd -n registry \
    --from-literal=htpasswd="$(htpasswd -nbB trainee "$registry_pw")"

  while read -r name password _; do
    grep -qx "$name" < <(trainees) || continue   # no longer in TRAINEES
    secret generic "console-$name" -n consoles --from-literal=password="$password"
  done < "$S/passwords.txt"

  while read -r name; do
    ns "$name"
    secret generic f021-repo -n "$name" \
      --from-file=identity="$S/deploy-keys/$name" \
      --from-file=identity.pub="$S/deploy-keys/$name.pub" \
      --from-file=known_hosts="$known_hosts"
  done < <(trainees)
} > secrets.yaml

echo "secrets.yaml written; apply it with: kubectl apply --server-side -f secrets.yaml"
openssl x509 -in "$L/issuer.crt" -noout -enddate | sed 's/^/linkerd issuer: /'
