#!/usr/bin/env bash
# One kubeconfig per trainee for their own machine (make kubeconfigs):
# a client certificate CN=<name>, O=trainees, signed by the cluster through
# the CertificateSigningRequest API, context `training`, namespace <name>.
# The tenant RoleBinding (`User <name>`) and the group grants (`trainees`,
# infrastructure/configs/rbac/) give it exactly the console's rights.
#
#   bin/kubeconfigs                  # every trainee of TRAINEES
#   bin/kubeconfigs user1 user2      # some of them
#
# Writes secrets/kubeconfigs/<name>.kubeconfig (git-ignored, with secrets/):
# hand each one to its trainee. Keys stay in secrets/kubeconfigs/<name>.key;
# an existing kubeconfig is kept, delete it to reissue. Certificates are
# valid EXPIRY seconds (default one week), the length of a session.
#
# Needs the trainer's cluster-admin kubeconfig (make kubeconfig) and openssl.
set -euo pipefail
cd "$(dirname "$0")/.."
. ./fleet.env

K="kubectl --kubeconfig=kubeconfig --context=training"
EXPIRY=${EXPIRY:-604800}
D=secrets/kubeconfigs
mkdir -p "$D"
chmod 700 secrets "$D"
umask 077

server=$($K config view --minify -o jsonpath='{.clusters[0].cluster.server}')
ca=$($K config view --minify --raw -o jsonpath='{.clusters[0].cluster.certificate-authority-data}')

if [ $# -gt 0 ]; then names=("$@"); else read -ra names <<< "$TRAINEES"; fi

for name in "${names[@]}"; do
  out=$D/$name.kubeconfig
  printf '%-8s ' "$name"
  if [ -s "$out" ]; then echo "kept $out"; continue; fi
  [ -s "$D/$name.key" ] || openssl ecparam -name prime256v1 -genkey -noout -out "$D/$name.key"
  csr=$(openssl req -new -key "$D/$name.key" -subj "/CN=$name/O=trainees" | base64 -w0)
  $K delete csr "trainee-$name" --ignore-not-found >/dev/null
  cat <<EOF | $K apply -f - >/dev/null
apiVersion: certificates.k8s.io/v1
kind: CertificateSigningRequest
metadata:
  name: trainee-$name
spec:
  request: $csr
  signerName: kubernetes.io/kube-apiserver-client
  expirationSeconds: $EXPIRY
  usages: [client auth]
EOF
  $K certificate approve "trainee-$name" >/dev/null
  crt=
  for _ in $(seq 20); do
    crt=$($K get csr "trainee-$name" -o jsonpath='{.status.certificate}')
    [ -n "$crt" ] && break
    sleep 1
  done
  [ -n "$crt" ] || { echo "not signed"; exit 1; }
  cat > "$out" <<EOF
apiVersion: v1
kind: Config
clusters:
  - name: training
    cluster:
      server: $server
      certificate-authority-data: $ca
users:
  - name: $name
    user:
      client-certificate-data: $crt
      client-key-data: $(base64 -w0 < "$D/$name.key")
contexts:
  - name: training
    context:
      cluster: training
      user: $name
      namespace: $name
current-context: training
EOF
  $K delete csr "trainee-$name" >/dev/null
  echo "wrote $out"
done
