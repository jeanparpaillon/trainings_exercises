# Settings read by the Makefile, bin/render and bin/gen-secrets.

# Public host name of the server: consoles at https://$HOST/<name>/,
# Headlamp at /headlamp/, registry., grafana., linkerd. subdomains.
HOST=srv2052563.hstgr.cloud

# Trainees: generic names, one namespace, console, Grafana login and Flux
# tenant each. Never a person's name: trainees are told which userN they
# are, and these files stay committable. After a change: make render, then
# make secrets, commit, push.
TRAINEES="user1 user2 user3 user4 user5 user6 user7 user8"

# Owner of the module 6 config repos, one per trainee: $GITHUB_OWNER/f021-<name>,
# created by the trainer from the sample app, with the trainee as collaborator.
GITHUB_OWNER=jeanparpaillon

# Console image (console/), built on the server and loaded into kind by
# make image. Bump the tag on every change to console/.
CONSOLE_IMAGE=f021-console:1

# Flux version: controllers (make bootstrap) and the consoles' CLI
# (console/Dockerfile FLUX_VERSION) must match.
FLUX_VERSION=2.9.6

# `admin` RBAC level: trainees are cluster-admin (see
# infrastructure/configs/rbac/). `false` = `trainee` level only, what the labs
# assume. `true` also needs trainees-cluster-admin.yaml uncommented in
# infrastructure/configs/rbac/kustomization.yaml.
TRAINEES_CLUSTER_ADMIN=false
