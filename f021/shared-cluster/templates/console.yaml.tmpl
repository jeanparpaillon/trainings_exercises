# Web console of trainee NAME — generated by bin/render from
# templates/console.yaml.tmpl. Do not edit: edit the template.
#
# ttyd serving `bash -l` at https://HOST/NAME/, behind basic auth: login
# `NAME`, password from Secret consoles/console-NAME (secrets.yaml, same
# password as their Grafana login). Image from console/ (make image): kubectl,
# helm, flux, git, jq, curl, dig. The home directory is a PVC, so whatever
# the trainee installs in ~/bin or clones survives pod restarts.
#
# The pod runs as ServiceAccount console-NAME, as user `ubuntu` (uid 1000):
# console-init writes a kubeconfig context `training` with that ServiceAccount's
# token and namespace NAME, where it is `admin` (tenants/NAME.yaml); cluster
# read comes through group system:serviceaccounts:consoles.
#
# Same layout as the f021bis consoles (../../f021bis/shared-cluster), without
# their dind sidecar.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: console-NAME
  namespace: consoles
  labels:
    console: NAME
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: console-NAME-home
  namespace: consoles
  labels:
    console: NAME
  annotations:
    # The trainee's work lives here: never pruned by Flux.
    kustomize.toolkit.fluxcd.io/prune: disabled
spec:
  storageClassName: standard
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 5Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: console-NAME
  namespace: consoles
  labels:
    console: NAME
spec:
  replicas: 1
  strategy:
    type: Recreate          # RWO home volume
  selector:
    matchLabels:
      console: NAME
  template:
    metadata:
      labels:
        console: NAME
    spec:
      serviceAccountName: console-NAME
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
      containers:
        - name: console
          image: console
          # Loaded into the kind node by make image, never pulled.
          imagePullPolicy: IfNotPresent
          args:
            - ttyd
            - --writable
            - --port=7681
            - --base-path=/NAME
            - --credential=NAME:$(CONSOLE_PASSWORD)
            - bash
            - -l
          env:
            - name: CONSOLE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: console-NAME
                  key: password
            - name: NS
              value: NAME
            - name: HOME
              value: /home/ubuntu
          workingDir: /home/ubuntu
          ports:
            - name: http
              containerPort: 7681
          volumeMounts:
            - name: home
              mountPath: /home/ubuntu
          resources:
            requests: {cpu: 50m, memory: 128Mi}
            limits: {memory: 1Gi}
      volumes:
        - name: home
          persistentVolumeClaim:
            claimName: console-NAME-home
---
apiVersion: v1
kind: Service
metadata:
  name: console-NAME
  namespace: consoles
  labels:
    console: NAME
spec:
  selector:
    console: NAME
  ports:
    - name: http
      port: 7681
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: console-NAME
  namespace: consoles
  labels:
    console: NAME
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
spec:
  ingressClassName: traefik
  rules:
    - host: HOST
      http:
        paths:
          - path: /NAME
            pathType: Prefix
            backend:
              service:
                name: console-NAME
                port:
                  name: http
