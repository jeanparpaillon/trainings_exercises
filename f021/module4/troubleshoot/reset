#!/usr/bin/env bash
# troubleshoot/reset — undo every scenario: back to the end of module 3
# (Bookinfo at harden/step4-spread, WordPress up with its data).
source "$(dirname "$0")/lib.sh"
for f in "$here"/scenarios/*.sh; do
  ( source "$f"; fix_it ) || echo "reset of $(basename "$f" .sh) failed, carrying on" >&2
done
$K apply -k "$module3/harden/step4-spread" >/dev/null
$K scale deploy/wordpress sts/mysql --replicas=1 >/dev/null
rolled_out 300s || die "a rollout is still stuck: kubectl -n $NS get pods, then ask the trainer"
$K rollout status sts/mysql --timeout=300s >/dev/null
if page_ok 10 && blog_ok; then
  echo "Your namespace is back to the end of module 3."
else
  die "still not healthy: ask the trainer"
fi
