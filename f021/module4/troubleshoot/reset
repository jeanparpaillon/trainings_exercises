#!/usr/bin/env bash
# troubleshoot/reset — undo every scenario: back to the end of the
# monitoring lab (WordPress and MySQL with its data as module 2 left them,
# plus loadgen, the MySQL exporter, your alerts and dashboard; no
# NetworkPolicy).
source "$(dirname "$0")/lib.sh"
for f in "$here"/scenarios/*.sh; do
  ( source "$f"; fix_it ) || echo "reset of $(basename "$f" .sh) failed, carrying on" >&2
done
# Leftovers of the module 2 network lab would block everything below.
$K delete networkpolicy default-deny allow-dns allow-from-traefik \
  allow-wordpress-to-mysql allow-mysql-from-wordpress --ignore-not-found >/dev/null
# The monitoring lab's rendered files, if it was skipped.
for t in step3-alerts/prometheusrule step4-dashboard/dashboard; do
  [ -f "$monitoring/$t.yaml" ] || sed "s/CHANGEME/$NS/g" "$monitoring/$t.yaml.tmpl" > "$monitoring/$t.yaml"
done
$K apply -k "$monitoring/step4-dashboard" >/dev/null
rolled_out 300s || die "a rollout is still stuck: kubectl -n $NS get pods, then ask the trainer"
if blog_ok; then
  echo "Your namespace is back to the end of the monitoring lab."
elif curl -s -m 10 -o /dev/null -w '%{redirect_url}' "$BLOG" | grep -q 'install\.php'; then
  # Nothing to undo: MySQL runs on a volume WordPress was never installed
  # on (a claim deleted by hand, or scenario 7 fixed onto a new volume).
  die "WordPress asks to be installed: its database is empty. Open $BLOG, install it, then run reset again."
else
  die "still not healthy: ask the trainer"
fi
