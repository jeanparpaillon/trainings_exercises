# Shared cluster: one host name per attendee, served by Traefik.
# Render it into ingress.yaml (git-ignored), which the kustomization uses:
#
#   sed "s/CHANGEME/$NS/g" wordpress/step1-deploy/ingress.yaml.tmpl \
#     > wordpress/step1-deploy/ingress.yaml
#
# nip.io resolves wordpress.<ns>.195.35.2.222.nip.io to the server, as for
# Bookinfo in lab 1.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: wordpress
spec:
  ingressClassName: traefik
  rules:
    - host: wordpress.CHANGEME.195.35.2.222.nip.io
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: wordpress
                port:
                  number: 80
